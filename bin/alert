#!/usr/bin/env bash
# alert: tell Anthony something broke, by text or phone call, through smshub.dev.
#
#   alert "fleet-db-backup failed on dev2"
#   alert --severity critical "coinpay webhooks are down"     always rings the phone
#   alert --key qc-sweep --every 6h "riotcoder-qc sweep is erroring"
#   alert --clear qc-sweep          it recovered: the next failure alerts at once
#   alert --check                   is the smshub key accepted? (daily cron)
#
# Posts to https://smshub.dev/api/v1/alerts with the API key in vault
# smshub--prod (SMSHUB_ALERT_API_KEY, Anthony's account), which texts his
# alert phone when a number can send SMS and otherwise calls it and reads the
# message. smshub sends the same text once per 10 minutes; on top of that,
# --key/--every (default: the message itself, 6h) keeps a cron job that fails
# every minute down to one alert per window. If smshub cannot be reached the
# alert is emailed instead (ALERT_EMAIL, default anthony@profullstack.com; set
# it in ~/.config/alert/env), so a failure is never silent. If smshub REJECTS
# the key (401/403) that email says so in its subject: the phone did not ring
# and will not for any alert until the key is replaced. `--check` asks smshub
# about the key without alerting anyone and sends that same email when it is
# rejected, so a revoked key is found by cron, not by the next real outage.
#
# The vault key is cached in ~/.local/state/alert/smshub-key (0600) and used
# when the vault cannot be read, so a logicsrc outage does not silence alerts.
#
# Exit 0 when sent or deliberately skipped, 1 when nothing went out.
# Log: ~/.local/state/alert/alert.log
set -uo pipefail

severity=warning key= every=6h to= dry=0 check=0
while [ $# -gt 0 ]; do
  case "$1" in
    --severity) severity=$2; shift 2 ;;
    --severity=*) severity=${1#*=}; shift ;;
    --key) key=$2; shift 2 ;;
    --key=*) key=${1#*=}; shift ;;
    --every) every=$2; shift 2 ;;
    --every=*) every=${1#*=}; shift ;;
    --to) to=$2; shift 2 ;;
    --to=*) to=${1#*=}; shift ;;
    --dry-run) dry=1; shift ;;
    --check) check=1; shift ;;
    --clear) rm -f "$HOME/.local/state/alert/$(printf '%s' "$2" | tr -c 'A-Za-z0-9._-' '_').last"; exit 0 ;;
    -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; break ;;
    -*) echo "alert: unknown option $1" >&2; exit 64 ;;
    *) break ;;
  esac
done
msg=$(printf '%s ' "$@" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')
[ "$check" = 1 ] && msg="smshub alert key check"
[ -n "$msg" ] || { echo 'usage: alert [--severity info|warning|critical] [--key k --every 6h] "message"' >&2; exit 64; }
host=$(hostname -s 2>/dev/null || hostname)
case "$msg" in "$host:"*) ;; *) msg="$host: $msg" ;; esac
msg=${msg:0:580}

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin"
# shellcheck disable=SC1091
[ -f "$HOME/.config/alert/env" ] && . "$HOME/.config/alert/env"
STATE="$HOME/.local/state/alert"
mkdir -p "$STATE"
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >>"$STATE/alert.log"; }
SMSHUB_URL=${SMSHUB_URL:-https://smshub.dev}

seconds() {
  case "$1" in
    *d) echo $(( ${1%d} * 86400 )) ;; *h) echo $(( ${1%h} * 3600 )) ;;
    *m) echo $(( ${1%m} * 60 )) ;; *s) echo "${1%s}" ;; *) echo "$1" ;;
  esac
}
apikey=${SMSHUB_ALERT_API_KEY:-} keysrc='the SMSHUB_ALERT_API_KEY environment variable (not the vault)'
if [ -z "$apikey" ]; then
  keysrc='vault smshub--prod SMSHUB_ALERT_API_KEY'
  tmp=$(mktemp -d "$STATE/v.XXXXXX")
  if logicsrc teams export profullstack smshub prod -o "$tmp/v.csv" --yes >/dev/null 2>&1; then
    apikey=$(python3 -I -c 'import csv,sys
for r in csv.DictReader(open(sys.argv[1])):
    if r["key"]=="SMSHUB_ALERT_API_KEY": print(r["value"])' "$tmp/v.csv")
  fi
  rm -rf "$tmp"
  # The vault (app.logicsrc.com) lives on the same box this script watches, so it
  # is down exactly when alerts matter most. Keep the last key it gave us (0600)
  # and use that when it cannot answer; a key smshub rejects is still caught below.
  cache="$STATE/smshub-key"
  if [ -n "$apikey" ]; then
    [ "$(cat "$cache" 2>/dev/null)" = "$apikey" ] || (umask 077; printf '%s\n' "$apikey" >"$cache.tmp" && mv "$cache.tmp" "$cache")
  elif [ -s "$cache" ]; then
    apikey=$(cat "$cache")
    keysrc="the cached copy $cache (vault smshub--prod did not answer)"
    log "vault unreachable or key missing: using cached smshub key"
  fi
fi

email() { # subject body
  mail send --to "${ALERT_EMAIL:-anthony@profullstack.com}" --subject "$1" --via resend --body "$2" >/dev/null 2>&1
}

# The key is broken, not smshub: say that loudly, once per 6h however many
# alerts hit it, and name where the key came from and how to replace it.
key_broken() { # http-code response [the alert that did not go out]
  log "KEY REJECTED by smshub HTTP $1 (key from $keysrc): ${2:0:200}"
  local ks="$STATE/smshub-key-broken.last"
  if [ -f "$ks" ] && [ $(( $(date +%s) - $(stat -c %Y "$ks") )) -lt 21600 ] && [ -z "${3:-}" ]; then return 0; fi
  email "[alert] $host: smshub alert key REJECTED (HTTP $1): alerts cannot call or text you${3:+ | $3}" "${3:+$3

}SMSHUB REJECTED THE ALERT API KEY (HTTP $1: ${2:0:200}).
Until it is replaced no alert from $host can call or text you; each one
falls back to an email like this.

The key came from $keysrc.
Fix: create a key at $SMSHUB_URL (Settings > API keys, Anthony's account),
then put it in the vault as SMSHUB_ALERT_API_KEY: logicsrc teams pull profullstack
smshub prod --env f.env, edit f.env, logicsrc teams push ... --env f.env, shred f.env.
Check: alert --check" && touch "$ks"
}

if [ "$check" = 1 ]; then
  [ -n "$apikey" ] || { log "check: no key ($keysrc)"; email "[alert] $host: no smshub alert key: alerts cannot call or text you" "alert --check on $host found no key in $keysrc (vault unreachable or key missing)."; exit 1; }
  out=$(curl -sS -m 30 -w '\n%{http_code}' "$SMSHUB_URL/api/v1/alerts?limit=1" -H "X-API-Key: $apikey" 2>&1)
  code=${out##*$'\n'}; out=${out%$'\n'*}
  case "$code" in
    200) rm -f "$STATE/smshub-key-broken.last"; log "check: key ok"; echo "smshub alert key ok"; exit 0 ;;
    401|403) key_broken "$code" "$out"; echo "smshub REJECTED the alert key (HTTP $code)" >&2; exit 1 ;;
    *) log "check: smshub HTTP $code (not a key answer): ${out:0:200}"; echo "smshub unreachable or erroring (HTTP $code); key not judged" >&2; exit 1 ;;
  esac
fi

[ -n "$key" ] || key=$(printf '%s' "$msg" | sha256sum | cut -c1-16)
key=$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_')
stamp="$STATE/$key.last"
window=$(seconds "$every")
if [ -f "$stamp" ] && [ $(( $(date +%s) - $(stat -c %Y "$stamp") )) -lt "$window" ]; then
  log "skip [$key] (sent within $every): $msg"
  exit 0
fi

if [ "$dry" = 1 ]; then echo "would alert ($severity): $msg"; exit 0; fi

body=$(jq -nc --arg m "$msg" --arg s "$severity" --arg t "$to" '{message:$m, severity:$s} + (if $t=="" then {} else {to:$t} end)')
out= code=000
if [ -n "$apikey" ]; then
  out=$(curl -sS -m 60 -w '\n%{http_code}' -X POST "$SMSHUB_URL/api/v1/alerts" \
    -H "X-API-Key: $apikey" -H 'Content-Type: application/json' --data "$body" 2>&1)
  code=${out##*$'\n'}
  out=${out%$'\n'*}
fi

if [ "$code" = 200 ] || [ "$code" = 201 ]; then
  touch "$stamp"
  log "sent [$key] $severity: $msg -> $(jq -r '(.alert.channels|join("+")) + ": " + .note' <<<"$out" 2>/dev/null || echo "$out")"
  exit 0
fi

# smshub said no (or is down): email, so the failure still reaches a person.
if [ "$code" = 401 ] || [ "$code" = 403 ]; then
  if key_broken "$code" "$out" "$msg"; then
    touch "$stamp"; log "emailed [$key] instead (key rejected): $msg"; exit 0
  fi
  log "FAILED [$key] nothing went out: $msg"; exit 1
fi
reason=${out:-no API key ($keysrc)}
log "smshub failed [$key] HTTP $code: $reason"
if email "[alert] $msg" "$msg

(smshub alert failed, HTTP $code: ${reason:0:300})"; then
  touch "$stamp"
  log "emailed [$key] instead: $msg"
  exit 0
fi
log "FAILED [$key] nothing went out: $msg"
exit 1
