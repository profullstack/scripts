#!/usr/bin/env bash
# Run the release gate before anything leaves this machine.
#
# CI runs this same `bin/scripts-check` on every push and tag, so the hook is
# not the only gate any more. It stays because it is the one that runs before
# the push rather than after it: a syntax error caught here never reaches the
# remote at all, and every tool in bin/ is a symlink into a working tree, so a
# broken one is on PATH on every box at the next upgrade.
#
# For a while it was the only gate. The workflow was deleted on 2026-08-29,
# when the job was refused before it ever started: an unpaid balance on the
# profullstack org suspends Actions compute on private repos.
#
# Note the balance is NOT this repo's CI minutes -- those are covered by the
# included allowance at net $0.00. It is Actions artifact storage and Code
# Quality credits run up on unrelated repos. So deleting the workflow saved no
# money; it was removed because a gate that cannot run is worse than no gate.
# The balance is still owed, and still suspends every private repo in the org.
# This one is public, which is why CI could come back here and not there.
#
# Set up by install.sh (`git config core.hooksPath .githooks`). To run the same
# checks by hand: `scripts-check`. To push past it in an emergency:
# `git push --no-verify`.

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
if [ -x "$root/bin/scripts-check" ]; then
  "$root/bin/scripts-check" || {
    echo ""
    echo "pre-push: refusing to push — scripts-check failed above."
    echo "          fix it, or 'git push --no-verify' if you must."
    exit 1
  }
fi
